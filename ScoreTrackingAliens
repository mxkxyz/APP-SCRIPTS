import pygame
import os
import json
import random
from pygame.locals import *

# High score file location
HIGH_SCORE_FILE = os.path.expanduser("~/.pygame_aliens_scores.json")

def load_high_score():
    if os.path.exists(HIGH_SCORE_FILE):
        with open(HIGH_SCORE_FILE, 'r') as f:
            return json.load(f).get("high_score", 0)
    return 0

def save_high_score(score):
    with open(HIGH_SCORE_FILE, 'w') as f:
        json.dump({"high_score": score}, f)

class ScoreTrackingAliens:
    def __init__(self):
        pygame.init()
        self.screen = pygame.display.set_mode((640, 480))
        pygame.display.set_caption("Alien Blaster")
        self.clock = pygame.time.Clock()
        self.font = pygame.font.SysFont(None, 36)

        self.score = 0
        self.high_score = load_high_score()

        # Player setup
        self.player = pygame.Rect(300, 440, 50, 20)
        self.bullets = []
        self.enemies = []
        self.enemy_spawn_delay = 1000  # milliseconds
        pygame.time.set_timer(USEREVENT + 1, self.enemy_spawn_delay)

    def run(self):
        running = True
        while running:
            self.clock.tick(60)
            for event in pygame.event.get():
                if event.type == QUIT:
                    running = False
                elif event.type == USEREVENT + 1:
                    self.spawn_enemy()
                elif event.type == KEYDOWN and event.key == K_SPACE:
                    self.shoot()

            keys = pygame.key.get_pressed()
            if keys[K_LEFT] and self.player.left > 0:
                self.player.move_ip(-5, 0)
            if keys[K_RIGHT] and self.player.right < 640:
                self.player.move_ip(5, 0)

            self.update_bullets()
            self.update_enemies()
            self.check_collisions()
            self.draw()

        if self.score > self.high_score:
            print(f"New high score: {self.score}")
            save_high_score(self.score)
        else:
            print(f"Score: {self.score} | High score: {self.high_score}")
        pygame.quit()

    def shoot(self):
        bullet = pygame.Rect(self.player.centerx - 2, self.player.top, 4, 10)
        self.bullets.append(bullet)

    def spawn_enemy(self):
        x = random.randint(0, 590)
        enemy = pygame.Rect(x, 0, 50, 30)
        self.enemies.append(enemy)

    def update_bullets(self):
        for bullet in self.bullets[:]:
            bullet.move_ip(0, -8)
            if bullet.bottom < 0:
                self.bullets.remove(bullet)

    def update_enemies(self):
        for enemy in self.enemies[:]:
            enemy.move_ip(0, 3)
            if enemy.top > 480:
                self.enemies.remove(enemy)

    def check_collisions(self):
        for bullet in self.bullets[:]:
            for enemy in self.enemies[:]:
                if bullet.colliderect(enemy):
                    self.bullets.remove(bullet)
                    self.enemies.remove(enemy)
                    self.score += 50
                    break

    def draw(self):
        self.screen.fill((0, 0, 0))
        pygame.draw.rect(self.screen, (0, 255, 0), self.player)

        for bullet in self.bullets:
            pygame.draw.rect(self.screen, (255, 255, 0), bullet)

        for enemy in self.enemies:
            pygame.draw.rect(self.screen, (255, 0, 0), enemy)

        score_text = self.font.render(f"Score: {self.score}", True, (255, 255, 255))
        high_score_text = self.font.render(f"High Score: {self.high_score}", True, (100, 255, 100))
        self.screen.blit(score_text, (20, 20))
        self.screen.blit(high_score_text, (20, 60))

        pygame.display.flip()
